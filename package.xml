<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aloha_yolo_pickup</name>
  <version>0.0.0</version>
  <description>YOLO object detection and sensor fusion for Mobile ALOHA.</description>
  <maintainer email="vignesh.tho2006@gmail.com">Vignesh Thondikulam</maintainer>
  <license>TODO: Licence</license>

  <depend>rclpy</depend>
    <depend>sensor_msgs</depend>
